# HTTPS front end for Crafty Accounting (used by docker-compose.yml).
# Settings come from .env:
#   SITE_ADDRESS  the address(es) you browse to, comma separated,
#                 e.g. "crafty.local, 192.168.1.50" or "accounts.example.co.uk"
#   TLS_ISSUER    "internal" for a private certificate from Caddy's own
#                 certificate authority (home network), or your email address
#                 to get a free Let's Encrypt certificate for a public domain.
#   SITE_IP       the IP address in SITE_ADDRESS that browsers use, if any
# Plain http:// requests are redirected to https:// automatically.

{
	# Browsers don't send an IP address as the server name, and Docker hides the
	# address they connected to, so Caddy needs telling which certificate to use.
	default_sni {$SITE_IP:localhost}
}

{$SITE_ADDRESS:localhost} {
	tls {$TLS_ISSUER:internal}
	# Compressing the live-update stream would hold its messages back.
	@compressible not path /api/events
	encode @compressible zstd gzip
	header -Server
	reverse_proxy crafty-accounting:3000 {
		# The browser's port, for HMRC's fraud prevention headers.
		header_up X-Client-Port {http.request.remote.port}
	}
}
