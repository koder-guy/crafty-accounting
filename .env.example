# Copy to .env and fill in. Docker Compose and `npm run dev` both read it.

# Password for signing in to the app (required).
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -hex 32
# If left empty, a secret is generated and stored in the data folder.
SESSION_SECRET=

# Port the app listens on (inside the container for Docker).
PORT=3000

# Largest document that can be attached, in megabytes.
MAX_UPLOAD_MB=20

# Set to true when the app is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik).
TRUST_PROXY=false

# Where the database and documents are stored (defaults to ./data; /data in Docker).
# DATA_DIR=./data
