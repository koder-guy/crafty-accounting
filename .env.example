# Copy to .env and fill in. Docker Compose and `npm run dev` both read it.

# Name and password for the first person to sign in, used only when no one
# has been set up yet (a new install, or an upgrade from the single shared
# password). After that, add people and change passwords in Settings → People;
# changing these values has no effect.
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -hex 32
# If left empty, a secret is generated and stored in the data folder.
SESSION_SECRET=

# Port the app listens on (inside the container for Docker).
PORT=3000

# Largest document that can be attached, in megabytes.
MAX_UPLOAD_MB=20

# HTTPS (Docker): the address(es) you'll browse to, comma separated.
# Home network: the server's name and/or IP, e.g. "crafty.local, 192.168.1.50".
# Public domain: e.g. "accounts.example.co.uk".
SITE_ADDRESS=localhost

# "internal" = a private certificate for the home network (trust it once on each
# device, see the README). For a public domain, put your email address here and
# Caddy will get a free Let's Encrypt certificate.
TLS_ISSUER=internal

# Ports Caddy listens on (Let's Encrypt needs 80 and 443 reachable from the internet).
HTTP_PORT=80
HTTPS_PORT=443

# Outside Docker only: set to true when served over HTTPS / behind a reverse proxy.
# (Docker Compose sets both to true because Caddy always provides HTTPS.)
COOKIE_SECURE=false
TRUST_PROXY=false

# Where the database and documents are stored (defaults to ./data; /data in Docker).
# DATA_DIR=./data

# Automatic backups (Docker): the host folder mapped to /backups in the container.
# Use a different disk or a NAS share if you can. Create it first and let the
# container's user write to it:  mkdir -p ./backups && sudo chown 1000:1000 ./backups
BACKUP_HOST_DIR=./backups

# Time zone for the daily backup time.
TZ=Europe/London

# Outside Docker, where automatic backups are written (defaults to DATA_DIR/backups).
# BACKUP_DIR=./data/backups
